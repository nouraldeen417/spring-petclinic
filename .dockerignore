# =============================================================================
# Files that must NOT be sent to the image build (smaller, faster, safer).
# The Dockerfile only needs dist/app.jar, so dist/ must NOT be listed here.
# =============================================================================

# Build output. The jar comes from dist/, not from target/.
target/
build/
# The image file written by Kaniko in an earlier step.
image.tar
*.tar

# Git and CI files
.git/
.gitignore
.github/
Jenkinsfile

# Kubernetes, platform and documentation files (not needed inside the image)
k8s/
platform/
docs/

# Docker files
Dockerfile
.dockerignore
docker-compose.yml

# IDE and OS files
.idea/
.vscode/
.settings/
.classpath
.project
*.iml
.DS_Store

# Docs and logs
*.md
*.log

# Secrets (never in an image)
.env
*.pem
*.key